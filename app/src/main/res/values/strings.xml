    <!-- How to Play -->
    <string name="how_to_play_title">How to Play</string>
    <string name="htp_cars_title">Two Cars</string>
    <string name="htp_cars_body">Control both cars at once. Tap the left side of the screen for the red car and the right side for the blue car.</string>
    <string name="htp_notes_title">Notes</string>
    <string name="htp_notes_body">Tap when a note reaches your car. The car moves to the note\'s lane and stays there.</string>
    <string name="htp_hold_title">Hold Notes</string>
    <string name="htp_hold_body">Press and hold for the whole long note, then release when it ends.</string>
    <string name="htp_obstacle_title">Obstacles</string>
    <string name="htp_obstacle_body">Tap just before the car reaches it to dodge. If you crash, you lose a heart.</string>
    <string name="htp_rating_title">Ratings</string>
    <string name="htp_rating_body">The closer your timing, the better: Perfect, Great or Miss. A Miss or a wrong tap breaks your combo.</string>
    <string name="htp_hearts_title">Hearts</string>
    <string name="htp_hearts_body">You have 3 hearts. Lose them all and the game is over.</string>
    <string name="htp_fever_title">Fever</string>
    <string name="htp_fever_body">Reach a combo of 100, 200, 300 and so on to trigger Fever, with bonus score for 10 seconds.</string>

