<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/road">
    <LinearLayout android:id="@+id/gameArea" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
        <FrameLayout android:id="@+id/lane1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/ivFx1" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="39dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/lane2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/ivCarRed" android:layout_width="48dp" android:layout_height="99dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="88dp" android:importantForAccessibility="no" android:src="@drawable/red_car" />
            <ImageView android:id="@+id/ivFx2" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="39dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/lane3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/ivFx3" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="39dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:id="@+id/lane4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:id="@+id/ivCarBlue" android:layout_width="48dp" android:layout_height="99dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="88dp" android:importantForAccessibility="no" android:src="@drawable/blue_car" />
            <ImageView android:id="@+id/ivFx4" android:layout_width="110dp" android:layout_height="110dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="39dp" android:importantForAccessibility="no" android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/ivFeverLeft" android:layout_width="90dp" android:layout_height="match_parent" android:layout_gravity="start" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
    <ImageView android:id="@+id/ivFeverRight" android:layout_width="90dp" android:layout_height="match_parent" android:layout_gravity="end" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" android:scaleX="-1" />
    <FrameLayout android:id="@+id/gameHud" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="100dp" android:alpha="0.9" android:gravity="center_horizontal" android:orientation="vertical">
            <TextView android:text="@string/combo_label" android:id="@+id/tvComboLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/orbitron_regular" android:textColor="#F3FBFF" android:textSize="20sp" android:visibility="invisible" android:shadowColor="#C000D9FF" android:shadowRadius="5" />
            <TextView android:text="0" android:id="@+id/tvCombo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/orbitron_regular" android:includeFontPadding="false" android:textColor="#F3FBFF" android:textSize="56sp" android:visibility="invisible" android:shadowColor="#C000D9FF" android:shadowRadius="5" />
        </LinearLayout>
        <ImageView android:id="@+id/ivFever" android:layout_width="280dp" android:layout_height="80dp" android:layout_gravity="center" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/fever" android:visibility="gone" />
        <ImageView android:id="@+id/ivJudgement" android:layout_width="200dp" android:layout_height="60dp" android:layout_gravity="center" android:importantForAccessibility="no" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageButton android:id="@+id/btnPause" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="top|start" android:layout_marginStart="12dp" android:layout_marginTop="12dp" android:background="@drawable/box" android:contentDescription="@string/pause" android:padding="16dp" android:scaleType="fitCenter" android:src="@drawable/pause" />
        <TextView android:text="0000000" android:id="@+id/tvScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="24dp" android:fontFamily="@font/orbitron_medium" android:shadowColor="#80000000" android:shadowDx="3" android:shadowDy="3" android:shadowRadius="3" android:textColor="#F3FBFF" android:textSize="19sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="26dp" android:layout_marginEnd="12dp" android:orientation="horizontal">
            <ImageView android:id="@+id/ivHeart1" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="2dp" android:importantForAccessibility="no" android:src="@drawable/heart" />
            <ImageView android:id="@+id/ivHeart2" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="2dp" android:importantForAccessibility="no" android:src="@drawable/heart" />
            <ImageView android:id="@+id/ivHeart3" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="2dp" android:importantForAccessibility="no" android:src="@drawable/heart" />
        </LinearLayout>
        <include android:id="@+id/pauseOverlay" layout="@layout/layout_pause" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
