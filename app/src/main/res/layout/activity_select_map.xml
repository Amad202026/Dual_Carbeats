<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/road" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
    <ImageButton android:id="@+id/btnBack" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginTop="12dp" android:background="@drawable/box" android:contentDescription="@string/back" android:padding="18dp" android:scaleType="fitCenter" android:src="@drawable/back" />
    <Space android:layout_width="match_parent" android:layout_height="16dp" />
    <TextView android:text="@string/choose_level" style="@style/ScreenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="18dp" android:clipToPadding="false" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:id="@+id/cardLevel1" android:layout_width="match_parent" android:layout_height="104dp" android:background="@drawable/bg_level_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="78dp" android:layout_height="78dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/cover_on_and_on" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:text="@string/song_on_and_on" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_bold" android:maxLines="2" android:ellipsize="end" android:textColor="#000000" android:textSize="18sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/difficulty" />
                            <TextView android:text="@string/difficulty_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                            <TextView android:text="@string/easy" android:id="@+id/tvDifficulty1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_bold" android:textColor="#1E8A1E" android:textSize="16sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/highscore" />
                            <TextView android:text="@string/highscore_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                            <TextView android:text="0" android:id="@+id/tvHighscore1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <ImageView android:id="@+id/ivFc1" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|bottom" android:importantForAccessibility="no" android:src="@drawable/full_combo" android:visibility="gone" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp">
                <LinearLayout android:id="@+id/cardLevel2" android:layout_width="match_parent" android:layout_height="104dp" android:background="@drawable/bg_level_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="78dp" android:layout_height="78dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/cover_safe_and_sound" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:text="@string/song_safe_and_sound" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_bold" android:maxLines="2" android:ellipsize="end" android:textColor="#000000" android:textSize="18sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/difficulty" />
                            <TextView android:text="@string/difficulty_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                            <TextView android:text="@string/medium" android:id="@+id/tvDifficulty2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_bold" android:textColor="#C8960C" android:textSize="16sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/highscore" />
                            <TextView android:text="@string/highscore_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                            <TextView android:text="0" android:id="@+id/tvHighscore2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <ImageView android:id="@+id/ivFc2" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|bottom" android:importantForAccessibility="no" android:src="@drawable/full_combo" android:visibility="gone" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/cardLevel3" android:layout_width="match_parent" android:layout_height="104dp" android:background="@drawable/bg_level_card" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                    <ImageView android:layout_width="78dp" android:layout_height="78dp" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/cover_monkeys" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView android:text="@string/song_monkeys" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_bold" android:maxLines="2" android:ellipsize="end" android:textColor="#000000" android:textSize="18sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/difficulty" />
                            <TextView android:text="@string/difficulty_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                            <TextView android:text="@string/hard" android:id="@+id/tvDifficulty3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_bold" android:textColor="#B00000" android:textSize="16sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" android:src="@drawable/highscore" />
                            <TextView android:text="@string/highscore_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                            <TextView android:text="0" android:id="@+id/tvHighscore3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/rajdhani_medium" android:textColor="#000000" android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <ImageView android:id="@+id/ivFc3" android:layout_width="42dp" android:layout_height="42dp" android:layout_gravity="end|bottom" android:importantForAccessibility="no" android:src="@drawable/full_combo" android:visibility="gone" android:layout_marginEnd="6dp" android:layout_marginBottom="6dp" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
    <Button android:id="@+id/btnPlay" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginStart="30dp" android:layout_marginEnd="30dp" android:layout_marginTop="10dp" android:background="@drawable/play_box" android:fontFamily="@font/rajdhani_bold" android:text="@string/play" android:textAllCaps="false" android:textColor="#000000" android:textSize="32sp" />
</LinearLayout>
