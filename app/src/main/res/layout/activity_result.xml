                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="2dp" android:background="#000000" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="vertical" android:minHeight="52dp" android:paddingTop="6dp" android:paddingBottom="6dp">
