            <TextView android:text="@string/result_song_title" android:id="@+id/tvSongTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/title_box" android:fontFamily="@font/rajdhani_bold" android:gravity="center" android:textColor="#000000" android:textSize="18sp" android:minHeight="64dp" android:padding="10dp" />
