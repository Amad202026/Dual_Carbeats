        <ImageButton android:id="@+id/btnMenu" android:layout_width="76dp" android:layout_height="76dp" android:background="@drawable/box" android:contentDescription="@string/song_menu" android:padding="22dp" android:scaleType="fitCenter" android:src="@drawable/select_music" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" />
