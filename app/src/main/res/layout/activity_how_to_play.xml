<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/road"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="20dp">
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/box"
        android:contentDescription="@string/back"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/back" />
    <TextView
        android:text="@string/how_to_play_title"
        style="@style/ScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/detail_box"
        android:padding="20dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="72dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/red_car" />
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="72dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/blue_car"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_cars_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_cars_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/red_not" />
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/blue_not"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_notes_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_notes_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="72dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/red_tail" />
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="72dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/blue_tail"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_hold_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_hold_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/obstacle" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_obstacle_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_obstacle_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/perfect" />
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/great"
                        android:layout_marginTop="6dp" />
                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/miss"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_rating_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_rating_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="38dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/heart" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_hearts_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_hearts_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="84dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/fever" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:text="@string/htp_fever_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowTitle" />
                    <TextView
                        android:text="@string/htp_fever_body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/RowBody" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
